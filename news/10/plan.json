 "subs": [
  {
   "s": 0.3,
   "e": 3.697,
   "text": "Er bat seinen besten Freund,\nnach seinem Tod alles zu verbrennen:"
  },
  {
   "s": 3.697,
   "e": 6.409,
   "text": "Tagebücher, Briefe,\nManuskripte – ungelesen."
  },
  {
   "s": 6.409,
   "e": 8.138,
   "text": "Der Freund tat es nicht."
  },
  {
   "s": 8.138,
   "e": 10.407,
   "text": "Deshalb kennen wir\nheute Franz Kafka."
  },
  {
   "s": 10.407,
   "e": 12.618,
   "text": "Zu Lebzeiten war\ner fast unbekannt."
  },
  {
   "s": 12.618,
   "e": 16.309,
   "text": "Heute steht sein Name\nsogar im Duden: kafkaesk."
  },
  {
   "s": 16.309,
   "e": 19.701,
   "text": "Kafka wurde 1883\nin Prag geboren."
  },
  {
   "s": 19.701,
   "e": 22.123,
   "text": "Die Familie war jüdisch\nund sprach Deutsch."
  },
  {
   "s": 22.123,
   "e": 25.375,
   "text": "Der Vater, Hermann Kafka,\nwar als armer Junge aufgewachsen"
  },
  {
   "s": 25.375,
   "e": 27.865,
   "text": "und hatte sich zum\nGeschäftsmann hochgearbeitet."
  },
  {
   "s": 27.865,
   "e": 29.748,
   "text": "Er war laut, kräftig und streng."
  },
  {
   "s": 29.748,
   "e": 32.718,
   "text": "Neben ihm fühlte sich der\nSohn ein Leben lang klein."
  },
  {
   "s": 32.718,
   "e": 36.845,
   "text": "Mit 36 schrieb Kafka ihm einen\nBrief von über hundert Seiten."
  },
  {
   "s": 36.845,
   "e": 39.451,
   "text": "Abgeschickt hat er ihn nie."
  },
  {
   "s": 39.451,
   "e": 42.755,
   "text": "Kafka studierte Jura und wurde\nBeamter einer Versicherung."
  },
  {
   "s": 42.755,
   "e": 45.166,
   "text": "Tagsüber prüfte er\nUnfälle in Fabriken."
  },
  {
   "s": 45.166,
   "e": 46.565,
   "text": "Nachts schrieb er."
  },
  {
   "s": 46.565,
   "e": 50.876,
   "text": "In einer einzigen Nacht im September\n1912 entstand „Das Urteil“."
  },
  {
   "s": 50.876,
   "e": 53.642,
   "text": "Wenige Wochen später schrieb\ner „Die Verwandlung“."
  },
  {
   "s": 53.642,
   "e": 55.771,
   "text": "Gregor Samsa wacht\neines Morgens auf –"
  },
  {
   "s": 55.771,
   "e": 57.869,
   "text": "und ist ein\nungeheures Ungeziefer."
  },
  {
   "s": 57.869,
   "e": 60.407,
   "text": "Bevor das Buch erschien,\nbat Kafka den Verlag:"
  },
  {
   "s": 60.407,
   "e": 64.205,
   "text": "Das Insekt dürfe auf keinen\nFall gezeichnet werden."
  },
  {
   "s": 64.205,
   "e": 67.444,
   "text": "Zweimal verlobte er sich\nmit Felice Bauer aus Berlin."
  },
  {
   "s": 67.444,
   "e": 69.344,
   "text": "Zweimal löste er die Verlobung."
  },
  {
   "s": 69.344,
   "e": 72.345,
   "text": "Er fürchtete, eine Ehe würde\nihm das Schreiben nehmen."
  },
  {
   "s": 72.345,
   "e": 75.562,
   "text": "1917 erkrankte er\nan Tuberkulose."
  },
  {
   "s": 75.562,
   "e": 78.046,
   "text": "Am Ende konnte er kaum\nnoch sprechen und essen."
  },
  {
   "s": 78.046,
   "e": 79.792,
   "text": "Auf dem Sterbebett\nlas er noch die"
  },
  {
   "s": 79.792,
   "e": 82.063,
   "text": "Druckfahnen von „Ein\nHungerkünstler“."
  },
  {
   "s": 82.063,
   "e": 87.175,
   "text": "Franz Kafka starb im\nJuni 1924, mit 40 Jahren."
  },
  {
   "s": 87.175,
   "e": 89.466,
   "text": "Sein Freund Max Brod\nfand zwei Zettel."
  },
  {
   "s": 89.466,
   "e": 91.437,
   "text": "Darauf stand: alles verbrennen."
  },
  {
   "s": 91.437,
   "e": 94.866,
   "text": "Brod hatte ihm schon früher gesagt,\ndass er das nie tun würde."
  },
  {
   "s": 94.866,
   "e": 98.392,
   "text": "Er veröffentlichte „Der Process“,\n„Das Schloss“ und „Amerika“."
  },
  {
   "s": 98.392,
   "e": 102.058,
   "text": "Als 1939 deutsche\nTruppen Prag besetzten,"
  },
  {
   "s": 102.058,
   "e": 104.689,
   "text": "floh Brod mit einem\nKoffer voller Manuskripte."
  },
  {
   "s": 104.689,
   "e": 108.667,
   "text": "Kafkas drei Schwestern\nwurden im Holocaust ermordet."
  },
  {
   "s": 108.667,
   "e": 110.674,
   "text": "Heute lesen wir\nKafka in der Schule."
  },
  {
   "s": 110.674,
   "e": 113.349,
   "text": "Und wenn uns ein Amt von\nSchalter zu Schalter schickt,"
  },
  {
   "s": 113.349,
   "e": 115.21,
   "text": "sagen wir: Das ist kafkaesk."
  },
  {
   "s": 115.21,
   "e": 118.509,
   "text": "Ein Wort, das es ohne einen\nungehorsamen Freund nicht gäbe."
  }
 ],
