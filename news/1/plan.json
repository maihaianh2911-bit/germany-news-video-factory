 "subs": [
  {
   "s": 1.0,
   "e": 2.431,
   "text": "44 Indizien.",
   "hl": [
    "44 Indizien"
   ]
  },
  {
   "s": 2.881,
   "e": 5.053,
   "text": "Eine lebenslange\nFreiheitsstrafe.",
   "hl": [
    "lebenslange"
   ]
  },
  {
   "s": 5.503,
   "e": 8.696,
   "text": "Und nur einen Tag später\nbeantragte die Verteidigung,",
   "hl": [
    "einen Tag"
   ]
  },
  {
   "s": 8.816,
   "e": 10.84,
   "text": "das Urteil\nüberprüfen zu lassen.",
   "hl": [
    "einen Tag"
   ]
  },
  {
   "s": 11.29,
   "e": 13.281,
   "text": "Warum hat das\nLandgericht Rostock",
   "hl": [
    "Landgericht Rostock"
   ]
  },
  {
   "s": 13.401,
   "e": 15.575,
   "text": "Gina H. im Fall\nFabian verurteilt?",
   "hl": [
    "Landgericht Rostock"
   ]
  },
  {
   "s": 16.025,
   "e": 18.928,
   "text": "Am 10. Oktober\n2025 verschwand der",
   "hl": [
    "Güstrow"
   ]
  },
  {
   "s": 19.048,
   "e": 21.726,
   "text": "achtjährige\nFabian in Güstrow,",
   "hl": [
    "Güstrow"
   ]
  },
  {
   "s": 21.976,
   "e": 24.406,
   "text": "einer Kleinstadt im\nNorden Deutschlands.",
   "hl": []
  },
  {
   "s": 24.856,
   "e": 27.158,
   "text": "Seine Mutter\nverständigte die Polizei.",
   "hl": []
  },
  {
   "s": 27.608,
   "e": 30.02,
   "text": "Vier Tage später wurde\nFabians Leiche an",
   "hl": [
    "Klein Upahl"
   ]
  },
  {
   "s": 30.14,
   "e": 32.98,
   "text": "einem kleinen Teich bei\nKlein Upahl gefunden,",
   "hl": [
    "Klein Upahl"
   ]
  },
  {
   "s": 33.23,
   "e": 36.294,
   "text": "etwa 15 Kilometer von\nseinem Zuhause entfernt.",
   "hl": []
  },
  {
   "s": 36.744,
   "e": 38.824,
   "text": "Gemeldet hatte den\nFundort Gina H.,",
   "hl": []
  },
  {
   "s": 38.944,
   "e": 41.144,
   "text": "die frühere Freundin\nseines Vaters.",
   "hl": []
  },
  {
   "s": 41.594,
   "e": 45.183,
   "text": "Sie sagte der Polizei, sie habe\ndie Leiche zufällig entdeckt.",
   "hl": []
  },
  {
   "s": 45.633,
   "e": 49.095,
   "text": "Doch vor Gericht schilderte\nein Zeuge ein anderes Detail.",
   "hl": []
  },
  {
   "s": 49.545,
   "e": 53.19,
   "text": "Er sagte, Gina H. selbst habe\nihn direkt zu dem Teich geführt.",
   "hl": [
    "direkt"
   ]
  },
  {
   "s": 53.64,
   "e": 55.33,
   "text": "Die Kammer glaubte\ndem Zeugen.",
   "hl": []
  },
  {
   "s": 55.78,
   "e": 59.099,
   "text": "Für das Gericht war die Art,\nwie Gina H. direkt dorthin ging,",
   "hl": []
  },
  {
   "s": 59.349,
   "e": 62.571,
   "text": "ein Hinweis darauf, dass sie\nden Ort schon vorher kannte.",
   "hl": []
  },
  {
   "s": 63.021,
   "e": 65.809,
   "text": "Diese Aussage war nur ein\nTeil der Indizienkette,",
   "hl": []
  },
  {
   "s": 66.059,
   "e": 69.553,
   "text": "die der Vorsitz der Kammer bei\nder Urteilsverkündung nannte.",
   "hl": []
  },
  {
   "s": 70.003,
   "e": 74.121,
   "text": "Das Gericht berücksichtigte\naußerdem Schuhabdrücke, Faserspuren",
   "hl": [
    "Schuhabdrücke"
   ]
  },
  {
   "s": 74.371,
   "e": 77.047,
   "text": "und dass das Handy von\nGina H. ausgeschaltet war,",
   "hl": [
    "Handy"
   ]
  },
  {
   "s": 77.297,
   "e": 78.249,
   "text": "etwa zu der Zeit,",
   "hl": []
  },
  {
   "s": 78.369,
   "e": 81.942,
   "text": "in der Fabian nach Feststellung\ndes Gerichts getötet wurde.",
   "hl": []
  },
  {
   "s": 82.392,
   "e": 85.363,
   "text": "Einen direkten Augenzeugen\nder Tat gibt es nicht.",
   "hl": [
    "Augenzeugen"
   ]
  },
  {
   "s": 85.813,
   "e": 89.234,
   "text": "Die Kammer kam zu ihrem Urteil,\nnachdem sie die Spuren",
   "hl": []
  },
  {
   "s": 89.484,
   "e": 91.243,
   "text": "mit den Aussagen\nund dem Ablauf",
   "hl": []
  },
  {
   "s": 91.363,
   "e": 93.36,
   "text": "der Ereignisse\nabgeglichen hatte.",
   "hl": []
  },
  {
   "s": 93.81,
   "e": 96.438,
   "text": "Gina H. hat mehrfach\nihre Unschuld beteuert.",
   "hl": []
  },
  {
   "s": 96.888,
   "e": 99.465,
   "text": "Ihre Verteidigung\nplädierte auf Freispruch.",
   "hl": [
    "Freispruch"
   ]
  },
  {
   "s": 99.915,
   "e": 103.063,
   "text": "Am 10. November\n2026 verurteilte das",
   "hl": [
    "Mordes"
   ]
  },
  {
   "s": 103.183,
   "e": 106.451,
   "text": "Landgericht Rostock\nsie wegen Mordes",
   "hl": [
    "Mordes"
   ]
  },
  {
   "s": 106.701,
   "e": 109.388,
   "text": "und stellte die besondere\nSchwere der Schuld fest.",
   "hl": [
    "besondere Schwere"
   ]
  },
  {
   "s": 109.838,
   "e": 113.249,
   "text": "Nach der Urteilsverkündung\nsagte Verteidiger Andreas Ohm,",
   "hl": [
    "Andreas Ohm"
   ]
  },
  {
   "s": 113.369,
   "e": 114.526,
   "text": "er sei überrascht,",
   "hl": [
    "Andreas Ohm"
   ]
  },
  {
   "s": 114.776,
   "e": 117.171,
   "text": "weil das Gericht den\nTatablauf in einigen",
   "hl": []
  },
  {
   "s": 117.291,
   "e": 119.327,
   "text": "Punkten anders\nrekonstruiert habe",
   "hl": []
  },
  {
   "s": 119.577,
   "e": 122.104,
   "text": "als die Staatsanwaltschaft\nin ihrer Anklage.",
   "hl": []
  },
  {
   "s": 122.554,
   "e": 126.959,
   "text": "Am 13. November bestätigte das\nGericht den Eingang des Antrags.",
   "hl": []
  },
  {
   "s": 127.409,
   "e": 130.242,
   "text": "Auf welche Rechtsfehler sich\ndie Verteidigung stützen will,",
   "hl": []
  },
  {
   "s": 130.492,
   "e": 132.388,
   "text": "hat sie noch nicht\nbekannt gegeben.",
   "hl": []
  },
  {
   "s": 132.838,
   "e": 135.621,
   "text": "In Deutschland heißt\ndieses Verfahren Revision.",
   "hl": [
    "Revision"
   ]
  },
  {
   "s": 136.071,
   "e": 137.817,
   "text": "Der Bundesgerichtshof prüft,",
   "hl": [
    "Bundesgerichtshof"
   ]
  },
  {
   "s": 137.937,
   "e": 141.026,
   "text": "wie das Landgericht\nRostock den Prozess geführt",
   "hl": [
    "Bundesgerichtshof"
   ]
  },
  {
   "s": 141.276,
   "e": 142.937,
   "text": "und das Recht\nangewendet hat.",
   "hl": []
  },
  {
   "s": 143.387,
   "e": 146.77,
   "text": "Weist er den Antrag zurück,\nbleibt das Urteil bestehen.",
   "hl": []
  },
  {
   "s": 147.22,
   "e": 149.555,
   "text": "Findet er Rechtsfehler,\ndie ausreichen,",
   "hl": []
  },
  {
   "s": 149.675,
   "e": 152.498,
   "text": "um das Urteil ganz oder\nteilweise aufzuheben,",
   "hl": []
  },
  {
   "s": 152.748,
   "e": 154.566,
   "text": "kann der Fall neu\nverhandelt werden.",
   "hl": []
  },
  {
   "s": 155.016,
   "e": 157.366,
   "text": "Noch ist das Urteil\nnicht rechtskräftig.",
   "hl": [
    "nicht rechtskräftig"
   ]
  },
  {
   "s": 157.816,
   "e": 160.122,
   "text": "Nach Zustellung des\nschriftlichen Urteils",
   "hl": []
  },
  {
   "s": 160.372,
   "e": 163.772,
   "text": "hat die Verteidigung einen\nMonat Zeit für ihre Begründung.",
   "hl": [
    "einen Monat"
   ]
  },
  {
   "s": 164.222,
   "e": 165.399,
   "text": "Dann wird sich zeigen,",
   "hl": []
  },
  {
   "s": 165.519,
   "e": 166.979,
   "text": "welche Punkte genau sie vom",
   "hl": []
  },
  {
   "s": 167.099,
   "e": 169.242,
   "text": "Bundesgerichtshof\nprüfen lassen will.",
   "hl": []
  },
  {
   "s": 169.692,
   "e": 171.112,
   "text": "Danke fürs Zuschauen.",
   "hl": []
  },
  {
   "s": 171.562,
   "e": 173.988,
   "text": "Bis zum nächsten\nUpdate im Fall Fabian.",
   "hl": []
  }
 ],
