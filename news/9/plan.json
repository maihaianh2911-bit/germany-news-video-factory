 "subs": [
  {
   "s": 0.3,
   "e": 3.524,
   "text": "Er schrieb über den Wilden Westen,\nals wäre er dabei gewesen."
  },
  {
   "s": 3.524,
   "e": 6.058,
   "text": "Er ließ sich als Old\nShatterhand fotografieren –"
  },
  {
   "s": 6.058,
   "e": 7.885,
   "text": "mit Fransenjacke und Gewehr."
  },
  {
   "s": 7.885,
   "e": 9.492,
   "text": "Millionen glaubten ihm."
  },
  {
   "s": 9.492,
   "e": 13.188,
   "text": "Doch als Karl May Winnetou erfand,\nwar er nie in Amerika gewesen."
  },
  {
   "s": 13.188,
   "e": 15.261,
   "text": "Seine Prärie kannte\ner aus Büchern."
  },
  {
   "s": 15.261,
   "e": 19.649,
   "text": "Und viele Jahre seines Lebens\nhatte er hinter Gittern verbracht."
  },
  {
   "s": 19.649,
   "e": 24.048,
   "text": "Karl May wurde 1842 in\nErnstthal in Sachsen geboren."
  },
  {
   "s": 24.048,
   "e": 25.902,
   "text": "Die Eltern waren arme Weber."
  },
  {
   "s": 25.902,
   "e": 28.423,
   "text": "Von vierzehn Kindern\nüberlebten nur fünf."
  },
  {
   "s": 28.423,
   "e": 29.717,
   "text": "Karl wurde Lehrer –"
  },
  {
   "s": 29.717,
   "e": 33.286,
   "text": "doch man warf ihm vor, die Uhr\neines Kollegen gestohlen zu haben."
  },
  {
   "s": 33.286,
   "e": 37.358,
   "text": "Er kam ins Gefängnis und\ndurfte nie wieder unterrichten."
  },
  {
   "s": 37.358,
   "e": 39.31,
   "text": "Danach wurde er zum Hochstapler."
  },
  {
   "s": 39.31,
   "e": 42.221,
   "text": "Er gab sich als Arzt aus,\nals Polizist, als Beamter."
  },
  {
   "s": 42.221,
   "e": 45.778,
   "text": "Insgesamt saß er rund sieben Jahre\nim Arbeitshaus und im Zuchthaus."
  },
  {
   "s": 45.778,
   "e": 48.122,
   "text": "Im Gefängnis verwaltete\ner die Bibliothek"
  },
  {
   "s": 48.122,
   "e": 51.013,
   "text": "und las alles über ferne Länder."
  },
  {
   "s": 51.013,
   "e": 52.819,
   "text": "In Freiheit begann\ner zu schreiben:"
  },
  {
   "s": 52.819,
   "e": 54.121,
   "text": "erst Fortsetzungsromane,"
  },
  {
   "s": 54.121,
   "e": 56.944,
   "text": "dann Abenteuer im Orient\nund im Wilden Westen."
  },
  {
   "s": 56.944,
   "e": 60.113,
   "text": "Sein Held hieß Old Shatterhand:\nstark, klug und edel."
  },
  {
   "s": 60.113,
   "e": 62.553,
   "text": "Sein Freund war der\nApachenhäuptling Winnetou."
  },
  {
   "s": 62.553,
   "e": 65.519,
   "text": "1893 erschien „Winnetou“."
  },
  {
   "s": 65.519,
   "e": 68.599,
   "text": "Viele Leser hielten Old\nShatterhand für Karl May selbst –"
  },
  {
   "s": 68.599,
   "e": 70.228,
   "text": "und May ließ sie in dem Glauben."
  },
  {
   "s": 70.228,
   "e": 73.577,
   "text": "Er nannte sich „Doktor“, mit\neinem Titel, den er gekauft hatte."
  },
  {
   "s": 73.577,
   "e": 77.642,
   "text": "Sein Haus in Radebeul taufte\ner „Villa Shatterhand“."
  },
  {
   "s": 77.642,
   "e": 80.392,
   "text": "Erst 1908 reiste\ner nach Amerika."
  },
  {
   "s": 80.392,
   "e": 82.436,
   "text": "Bis in den Wilden\nWesten kam er nie."
  },
  {
   "s": 82.436,
   "e": 85.864,
   "text": "Inzwischen hatten Journalisten\nseine Vergangenheit aufgedeckt."
  },
  {
   "s": 85.864,
   "e": 88.494,
   "text": "Es folgten Prozesse,\nSpott und Feindschaft."
  },
  {
   "s": 88.494,
   "e": 92.756,
   "text": "Im März 1912 hielt er in Wien\neinen Vortrag vor großem Publikum."
  },
  {
   "s": 92.756,
   "e": 94.041,
   "text": "Man feierte ihn."
  },
  {
   "s": 94.041,
   "e": 97.337,
   "text": "Eine gute Woche später\nwar Karl May tot."
  },
  {
   "s": 97.337,
   "e": 99.836,
   "text": "Heute ist die Villa\nShatterhand ein Museum."
  },
  {
   "s": 99.836,
   "e": 103.867,
   "text": "Seine Bücher wurden weltweit\nrund 200 Millionen Mal gedruckt."
  },
  {
   "s": 103.867,
   "e": 107.329,
   "text": "Und in Bad Segeberg reitet Winnetou\njeden Sommer über die Bühne."
  },
  {
   "s": 107.329,
   "e": 109.867,
   "text": "Karl May war nie dort,\nwo seine Helden lebten."
  },
  {
   "s": 109.867,
   "e": 112.87,
   "text": "Aber Millionen Kinder sind\nmit ihnen dorthin geritten."
  }
 ],
