 "subs": [
  {
   "s": 0.3,
   "e": 4.387,
   "text": "„Dieses war der erste Streich,\ndoch der zweite folgt sogleich.“"
  },
  {
   "s": 4.387,
   "e": 6.726,
   "text": "Diese Zeilen kennt sicher jeder."
  },
  {
   "s": 6.726,
   "e": 8.526,
   "text": "Ihr Erfinder, Wilhelm Busch,"
  },
  {
   "s": 8.526,
   "e": 11.692,
   "text": "bekam für Max und Moritz\nein einziges Honorar:"
  },
  {
   "s": 11.692,
   "e": 13.46,
   "text": "1000 Gulden."
  },
  {
   "s": 13.46,
   "e": 16.629,
   "text": "Für den Verleger wurde\ndas Buch ein Vermögen."
  },
  {
   "s": 16.629,
   "e": 19.776,
   "text": "Und Busch selbst hielt sich\nnicht für einen Dichter,"
  },
  {
   "s": 19.776,
   "e": 22.446,
   "text": "sondern für einen\ngescheiterten Maler."
  },
  {
   "s": 22.446,
   "e": 27.805,
   "text": "Rund 1000 Ölbilder malte er –\nund zeigte sie fast niemandem."
  },
  {
   "s": 27.805,
   "e": 34.021,
   "text": "Geboren wurde er 1832 in Wiedensahl,\neinem Dorf in Niedersachsen."
  },
  {
   "s": 34.021,
   "e": 37.465,
   "text": "Er war das älteste von\nsieben Kindern eines Krämers."
  },
  {
   "s": 37.465,
   "e": 41.727,
   "text": "Mit neun schickten ihn die Eltern\nzu seinem Onkel, einem Pfarrer."
  },
  {
   "s": 41.727,
   "e": 45.146,
   "text": "Dort, in Ebergötzen, fand\ner seinen besten Freund:"
  },
  {
   "s": 45.146,
   "e": 49.015,
   "text": "Erich Bachmann,\nden Sohn des Müllers."
  },
  {
   "s": 49.015,
   "e": 52.202,
   "text": "Der Vater wollte einen\nIngenieur aus ihm machen."
  },
  {
   "s": 52.202,
   "e": 55.498,
   "text": "Busch begann ein Studium des\nMaschinenbaus in Hannover –"
  },
  {
   "s": 55.498,
   "e": 56.758,
   "text": "und brach ab."
  },
  {
   "s": 56.758,
   "e": 60.689,
   "text": "Er ging an die Kunstakademien\nin Düsseldorf und Antwerpen."
  },
  {
   "s": 60.689,
   "e": 64.938,
   "text": "In Antwerpen sah er die Bilder\nder alten niederländischen Meister"
  },
  {
   "s": 64.938,
   "e": 68.04,
   "text": "und verlor den Mut:\nSo gut würde er nie malen."
  },
  {
   "s": 68.04,
   "e": 69.252,
   "text": "In München begann er,"
  },
  {
   "s": 69.252,
   "e": 73.503,
   "text": "Bildergeschichten für\nZeitschriften zu zeichnen."
  },
  {
   "s": 73.503,
   "e": 77.401,
   "text": "1865 erschien Max und Moritz."
  },
  {
   "s": 77.401,
   "e": 80.929,
   "text": "Zwei Jungen spielen einem\nganzen Dorf böse Streiche:"
  },
  {
   "s": 80.929,
   "e": 84.755,
   "text": "der Witwe Bolte, dem Schneider\nBöck, dem Lehrer Lämpel."
  },
  {
   "s": 84.755,
   "e": 88.874,
   "text": "Am Ende landen sie in der Mühle –\nund die Enten fressen sie auf."
  },
  {
   "s": 88.874,
   "e": 91.867,
   "text": "Zuerst verkaufte sich\ndas Buch nur langsam."
  },
  {
   "s": 91.867,
   "e": 95.527,
   "text": "Dann wurde es ein Klassiker,\nübersetzt in viele Sprachen."
  },
  {
   "s": 95.527,
   "e": 98.846,
   "text": "In Amerika entstanden daraus\ndie Katzenjammer Kids,"
  },
  {
   "s": 98.846,
   "e": 102.327,
   "text": "einer der ersten\nComics der Welt."
  },
  {
   "s": 102.327,
   "e": 104.88,
   "text": "Viele seiner Verse\nsagen wir noch heute:"
  },
  {
   "s": 104.88,
   "e": 108.58,
   "text": "„Vater werden ist nicht schwer,\nVater sein dagegen sehr.“"
  },
  {
   "s": 108.58,
   "e": 111.308,
   "text": "Oder: „Wer Sorgen hat,\nhat auch Likör.“"
  },
  {
   "s": 111.308,
   "e": 114.444,
   "text": "Hinter dem Spott steckte\nein ernster Mensch."
  },
  {
   "s": 114.444,
   "e": 116.62,
   "text": "Er las Schopenhauer und Darwin"
  },
  {
   "s": 116.62,
   "e": 120.378,
   "text": "und mied die Gesellschaft\nder großen Städte."
  },
  {
   "s": 120.378,
   "e": 122.105,
   "text": "Er heiratete nie."
  },
  {
   "s": 122.105,
   "e": 126.203,
   "text": "Er lebte bei seiner Schwester Fanny\nund ihren Söhnen auf dem Land."
  },
  {
   "s": 126.203,
   "e": 129.415,
   "text": "Dort malte er, Jahr für\nJahr, kleine Bilder in Öl:"
  },
  {
   "s": 129.415,
   "e": 132.324,
   "text": "Landschaften, Bauern,\nWirtshausszenen."
  },
  {
   "s": 132.324,
   "e": 134.274,
   "text": "Ausgestellt hat er sie nie."
  },
  {
   "s": 134.274,
   "e": 140.14,
   "text": "Am 9. Januar 1908 starb\nWilhelm Busch, mit 75 Jahren."
  },
  {
   "s": 140.14,
   "e": 142.798,
   "text": "Heute hängen seine\nBilder im Museum."
  },
  {
   "s": 142.798,
   "e": 147.136,
   "text": "Doch berühmt bleibt er für zwei\nJungen, die nie brav sein wollten."
  },
  {
   "s": 147.136,
   "e": 150.657,
   "text": "„Gott sei Dank! Nun ist’s\nvorbei mit der Übeltäterei!“"
  }
 ],
