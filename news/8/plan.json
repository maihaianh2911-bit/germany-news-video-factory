 "subs": [
  {
   "s": 0.3,
   "e": 3.251,
   "text": "Ein Mädchen spielt mit\nStreichhölzern und verbrennt."
  },
  {
   "s": 3.251,
   "e": 6.611,
   "text": "Ein Junge will keine Suppe essen –\nnach fünf Tagen ist er tot."
  },
  {
   "s": 6.611,
   "e": 9.501,
   "text": "Einem anderen schneidet der\nSchneider die Daumen ab."
  },
  {
   "s": 9.501,
   "e": 11.728,
   "text": "Das klingt nicht nach\neinem Kinderbuch."
  },
  {
   "s": 11.728,
   "e": 14.338,
   "text": "Und doch ist es eines der\nbekanntesten der Welt:"
  },
  {
   "s": 14.338,
   "e": 15.847,
   "text": "der Struwwelpeter."
  },
  {
   "s": 15.847,
   "e": 18.181,
   "text": "Geschrieben hat ihn\nein Frankfurter Arzt –"
  },
  {
   "s": 18.181,
   "e": 21.76,
   "text": "als Weihnachtsgeschenk für\nseinen dreijährigen Sohn."
  },
  {
   "s": 21.76,
   "e": 26.027,
   "text": "Heinrich Hoffmann wurde 1809\nin Frankfurt am Main geboren."
  },
  {
   "s": 26.027,
   "e": 28.755,
   "text": "Er wurde Arzt und behandelte\nvor allem arme Leute."
  },
  {
   "s": 28.755,
   "e": 31.174,
   "text": "Kleinen Patienten\nzeichnete er oft etwas,"
  },
  {
   "s": 31.174,
   "e": 34.364,
   "text": "damit sie keine Angst\nvor dem Doktor hatten."
  },
  {
   "s": 34.364,
   "e": 39.475,
   "text": "Kurz vor Weihnachten 1844 suchte er\nein Bilderbuch für seinen Sohn Carl."
  },
  {
   "s": 39.475,
   "e": 42.087,
   "text": "Er fand nur langweilige,\nbelehrende Bücher."
  },
  {
   "s": 42.087,
   "e": 43.765,
   "text": "Also kaufte er ein leeres Heft"
  },
  {
   "s": 43.765,
   "e": 46.587,
   "text": "und zeichnete und dichtete\ndie Geschichten selbst."
  },
  {
   "s": 46.587,
   "e": 48.783,
   "text": "Freunde sahen das Heft\nund überredeten ihn,"
  },
  {
   "s": 48.783,
   "e": 50.256,
   "text": "es drucken zu lassen."
  },
  {
   "s": 50.256,
   "e": 55.691,
   "text": "1845 erschien es – unter dem\nNamen „Reimerich Kinderlieb“."
  },
  {
   "s": 55.691,
   "e": 57.131,
   "text": "Da ist der Struwwelpeter,"
  },
  {
   "s": 57.131,
   "e": 60.017,
   "text": "der sich nie die Haare und\ndie Nägel schneiden lässt."
  },
  {
   "s": 60.017,
   "e": 62.468,
   "text": "Der Suppen-Kaspar,\nder immer dünner wird."
  },
  {
   "s": 62.468,
   "e": 65.579,
   "text": "Paulinchen, die allein zu Hause\nmit dem Feuerzeug spielt –"
  },
  {
   "s": 65.579,
   "e": 68.353,
   "text": "obwohl ihre Katzen Minz\nund Maunz sie noch warnen."
  },
  {
   "s": 68.353,
   "e": 71.263,
   "text": "Der Zappel-Philipp, der bei\nTisch nicht still sitzen kann."
  },
  {
   "s": 71.263,
   "e": 74.074,
   "text": "Und Hans Guck-in-die-Luft,\nder in den Fluss fällt."
  },
  {
   "s": 74.074,
   "e": 76.204,
   "text": "Eine Geschichte ist\nsogar gegen Spott:"
  },
  {
   "s": 76.204,
   "e": 78.622,
   "text": "Drei Jungen lachen über\neinen schwarzen Jungen –"
  },
  {
   "s": 78.622,
   "e": 82.768,
   "text": "zur Strafe taucht der große\nNikolas sie ins Tintenfass."
  },
  {
   "s": 82.768,
   "e": 84.904,
   "text": "Das Buch wurde ein\nriesiger Erfolg."
  },
  {
   "s": 84.904,
   "e": 86.821,
   "text": "Es wurde in viele\nSprachen übersetzt –"
  },
  {
   "s": 86.821,
   "e": 89.245,
   "text": "sogar Mark Twain übertrug\nes ins Englische."
  },
  {
   "s": 89.245,
   "e": 90.91,
   "text": "Und manches sagen wir bis heute:"
  },
  {
   "s": 90.91,
   "e": 93.575,
   "text": "Ein unruhiges Kind nennen\nwir einen Zappelphilipp,"
  },
  {
   "s": 93.575,
   "e": 97.086,
   "text": "wer nicht essen will,\nist ein Suppenkasper."
  },
  {
   "s": 97.086,
   "e": 98.831,
   "text": "Hoffmann selbst blieb Arzt."
  },
  {
   "s": 98.831,
   "e": 103.825,
   "text": "1851 übernahm er die Frankfurter\nAnstalt für Irre und Epileptische."
  },
  {
   "s": 103.825,
   "e": 106.957,
   "text": "Er wollte die Kranken nicht\nwegsperren, sondern heilen."
  },
  {
   "s": 106.957,
   "e": 109.355,
   "text": "Er ließ ihnen ein neues,\nhelles Haus bauen –"
  },
  {
   "s": 109.355,
   "e": 111.855,
   "text": "die Frankfurter nannten\nes das Irrenschloss."
  },
  {
   "s": 111.855,
   "e": 117.366,
   "text": "Heinrich Hoffmann starb 1894\nin Frankfurt, mit 85 Jahren."
  },
  {
   "s": 117.366,
   "e": 119.674,
   "text": "Heute erinnert dort\nein Museum an ihn."
  },
  {
   "s": 119.674,
   "e": 122.586,
   "text": "Und sein Buch beginnt noch\nimmer mit denselben Zeilen:"
  },
  {
   "s": 122.586,
   "e": 125.689,
   "text": "„Sieh einmal, hier steht er,\npfui! der Struwwelpeter!“"
  }
 ],
