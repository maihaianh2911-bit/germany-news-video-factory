 "subs": [
  {
   "s": 0.3,
   "e": 4.949,
   "text": "Johann Wolfgang von Goethe wurde\nmit 25 über Nacht berühmt –"
  },
  {
   "s": 4.949,
   "e": 9.469,
   "text": "mit einem Roman über einen jungen\nMann, der an der Liebe zerbricht."
  },
  {
   "s": 9.469,
   "e": 12.51,
   "text": "Danach arbeitete er\nfast 60 Jahre lang"
  },
  {
   "s": 12.51,
   "e": 14.771,
   "text": "an einem einzigen Werk: Faust."
  },
  {
   "s": 14.771,
   "e": 18.336,
   "text": "Den zweiten Teil versiegelte\ner kurz vor seinem Tod."
  },
  {
   "s": 18.336,
   "e": 21.674,
   "text": "Er sollte erst erscheinen,\nwenn Goethe nicht mehr lebte."
  },
  {
   "s": 21.674,
   "e": 25.446,
   "text": "Im März 1832 starb er in Weimar,"
  },
  {
   "s": 25.446,
   "e": 27.434,
   "text": "mit 82 Jahren."
  }
 ],
