 "subs": [
  {
   "s": 0.3,
   "e": 4.949,
   "text": "Johann Wolfgang von Goethe wurde\nmit 25 über Nacht berühmt –"
  },
  {
   "s": 4.949,
   "e": 9.469,
   "text": "mit einem Roman über einen jungen\nMann, der an der Liebe zerbricht."
  },
  {
   "s": 9.469,
   "e": 12.51,
   "text": "Danach arbeitete er\nfast 60 Jahre lang"
  },
  {
   "s": 12.51,
   "e": 14.771,
   "text": "an einem einzigen Werk: Faust."
  },
  {
   "s": 14.771,
   "e": 18.336,
   "text": "Den zweiten Teil versiegelte\ner kurz vor seinem Tod."
  },
  {
   "s": 18.336,
   "e": 21.674,
   "text": "Er sollte erst erscheinen,\nwenn Goethe nicht mehr lebte."
  },
  {
   "s": 21.674,
   "e": 25.446,
   "text": "Im März 1832 starb er in Weimar,"
  },
  {
   "s": 25.446,
   "e": 28.584,
   "text": "mit 82 Jahren."
  },
  {
   "s": 28.584,
   "e": 35.21,
   "text": "Geboren wurde er am 28. August\n1749 in Frankfurt am Main."
  },
  {
   "s": 35.21,
   "e": 38.986,
   "text": "Der Vater, Johann Caspar,\nwar ein wohlhabender Jurist."
  },
  {
   "s": 38.986,
   "e": 43.398,
   "text": "Die Mutter, Catharina Elisabeth,\nwar bei der Hochzeit 17."
  },
  {
   "s": 43.398,
   "e": 45.057,
   "text": "Später schrieb Goethe:"
  },
  {
   "s": 45.057,
   "e": 48.689,
   "text": "„Vom Vater hab ich die Statur,\ndes Lebens ernstes Führen,"
  },
  {
   "s": 48.689,
   "e": 53.539,
   "text": "vom Mütterchen die Frohnatur\nund Lust zu fabulieren.“"
  },
  {
   "s": 53.539,
   "e": 58.037,
   "text": "Mit 16 schickte ihn der Vater\nzum Jurastudium nach Leipzig."
  },
  {
   "s": 58.037,
   "e": 61.649,
   "text": "Dort zeichnete er, schrieb\nGedichte, verliebte sich –"
  },
  {
   "s": 61.649,
   "e": 63.483,
   "text": "und studierte wenig."
  },
  {
   "s": 63.483,
   "e": 66.007,
   "text": "In Straßburg beendete\ner das Studium"
  },
  {
   "s": 66.007,
   "e": 70.156,
   "text": "und verliebte sich in Friederike\nBrion, eine Pfarrerstochter."
  },
  {
   "s": 70.156,
   "e": 72.539,
   "text": "Er verließ sie.\nSpäter schrieb er:"
  },
  {
   "s": 72.539,
   "e": 77.267,
   "text": "„Ich hatte das schönste Herz\nin seinem Tiefsten verwundet.“"
  },
  {
   "s": 77.267,
   "e": 81.746,
   "text": "1772 ging er ans\nReichskammergericht nach Wetzlar."
  },
  {
   "s": 81.746,
   "e": 84.613,
   "text": "Dort verliebte er sich\nin Charlotte Buff –"
  },
  {
   "s": 84.613,
   "e": 86.447,
   "text": "doch sie war schon verlobt."
  },
  {
   "s": 86.447,
   "e": 90.396,
   "text": "Kurz darauf erschoss sich ein\nBekannter aus unglücklicher Liebe."
  },
  {
   "s": 90.396,
   "e": 93.965,
   "text": "Aus beidem schrieb Goethe in\nwenigen Wochen einen Roman:"
  },
  {
   "s": 93.965,
   "e": 96.354,
   "text": "Die Leiden des jungen Werthers."
  },
  {
   "s": 96.354,
   "e": 99.022,
   "text": "Junge Männer kleideten\nsich wie Werther,"
  },
  {
   "s": 99.022,
   "e": 102.461,
   "text": "in blauem Frack\nund gelber Weste."
  },
  {
   "s": 102.461,
   "e": 107.682,
   "text": "1775 holte ihn der junge\nHerzog Carl August nach Weimar."
  },
  {
   "s": 107.682,
   "e": 110.746,
   "text": "Goethe blieb dort für\nden Rest seines Lebens."
  },
  {
   "s": 110.746,
   "e": 114.177,
   "text": "Er wurde Minister – zum\nSchreiben kam er kaum noch."
  },
  {
   "s": 114.177,
   "e": 119.237,
   "text": "1786 floh er heimlich nach\nItalien, unter falschem Namen,"
  },
  {
   "s": 119.237,
   "e": 122.192,
   "text": "für fast zwei Jahre."
  },
  {
   "s": 122.192,
   "e": 125.813,
   "text": "Zurück in Weimar lernte er\nChristiane Vulpius kennen,"
  },
  {
   "s": 125.813,
   "e": 129.076,
   "text": "die in einer Werkstatt\nkünstliche Blumen machte."
  },
  {
   "s": 129.076,
   "e": 132.54,
   "text": "Sie lebten ohne Trauschein\nzusammen – ein Skandal."
  },
  {
   "s": 132.54,
   "e": 137.034,
   "text": "1794 begann die Freundschaft\nmit Friedrich Schiller."
  },
  {
   "s": 137.034,
   "e": 140.328,
   "text": "Elf Jahre lang trieben\nsie sich gegenseitig an."
  },
  {
   "s": 140.328,
   "e": 143.956,
   "text": "Schiller drängte ihn,\nden Faust weiterzuschreiben."
  },
  {
   "s": 143.956,
   "e": 147.51,
   "text": "Als Schiller 1805 starb,\nschrieb Goethe,"
  },
  {
   "s": 147.51,
   "e": 150.325,
   "text": "er verliere „die\nHälfte meines Daseins“."
  },
  {
   "s": 150.325,
   "e": 154.215,
   "text": "Ein Jahr später\nheiratete er Christiane."
  },
  {
   "s": 154.215,
   "e": 157.707,
   "text": "1808 erschien Faust,\nder erste Teil."
  },
  {
   "s": 157.707,
   "e": 163.733,
   "text": "Den zweiten Teil vollendete\ner im Sommer 1831, mit 81."
  },
  {
   "s": 163.733,
   "e": 166.293,
   "text": "Dann versiegelte\ner das Manuskript."
  },
  {
   "s": 166.293,
   "e": 170.72,
   "text": "Am 22. März 1832 starb er."
  },
  {
   "s": 170.72,
   "e": 174.272,
   "text": "Seine letzten Worte sollen\n„Mehr Licht!“ gewesen sein."
  }
 ],
