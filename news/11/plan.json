 "subs": [
  {
   "s": 0.3,
   "e": 2.672,
   "text": "„Herr von Ribbeck auf\nRibbeck im Havelland,"
  },
  {
   "s": 2.672,
   "e": 4.819,
   "text": "ein Birnbaum in\nseinem Garten stand.“"
  },
  {
   "s": 4.819,
   "e": 6.969,
   "text": "Diese Zeilen kennen\nwir aus der Schule."
  },
  {
   "s": 6.969,
   "e": 9.083,
   "text": "Geschrieben hat sie\nTheodor Fontane."
  },
  {
   "s": 9.083,
   "e": 11.456,
   "text": "Bevor er Dichter wurde,\nwar er Apotheker."
  },
  {
   "s": 11.456,
   "e": 15.071,
   "text": "Seinen ersten Roman\nveröffentlichte er erst mit 58."
  },
  {
   "s": 15.071,
   "e": 18.964,
   "text": "Und sein berühmtestes Buch\nschrieb er mit über 70."
  },
  {
   "s": 18.964,
   "e": 22.569,
   "text": "Fontane wurde 1819\nin Neuruppin geboren."
  },
  {
   "s": 22.569,
   "e": 25.373,
   "text": "Seine Vorfahren waren\nHugenotten aus Frankreich."
  },
  {
   "s": 25.373,
   "e": 27.153,
   "text": "Der Vater führte eine Apotheke –"
  },
  {
   "s": 27.153,
   "e": 29.486,
   "text": "und verspielte viel\nGeld beim Kartenspiel."
  },
  {
   "s": 29.486,
   "e": 31.511,
   "text": "Er musste die\nApotheke verkaufen."
  },
  {
   "s": 31.511,
   "e": 34.321,
   "text": "Auch Theodor lernte Apotheker."
  },
  {
   "s": 34.321,
   "e": 37.961,
   "text": "Doch lieber schrieb er Gedichte,\nBalladen und Zeitungsartikel."
  },
  {
   "s": 37.961,
   "e": 41.968,
   "text": "1849 gab er den Beruf\nauf und wurde Journalist."
  },
  {
   "s": 41.968,
   "e": 44.666,
   "text": "Jahrelang lebte er als\nKorrespondent in London."
  },
  {
   "s": 44.666,
   "e": 47.649,
   "text": "Zurück in Preußen wanderte\ner durch die Mark Brandenburg"
  },
  {
   "s": 47.649,
   "e": 52.035,
   "text": "und schrieb seine „Wanderungen\ndurch die Mark Brandenburg“."
  },
  {
   "s": 52.035,
   "e": 56.116,
   "text": "1870 reiste er als Reporter\nin den Krieg nach Frankreich."
  },
  {
   "s": 56.116,
   "e": 59.32,
   "text": "Dort hielt man ihn für einen\nSpion und nahm ihn gefangen."
  },
  {
   "s": 59.32,
   "e": 61.527,
   "text": "Erst Bismarck setzte\nsich für ihn ein."
  },
  {
   "s": 61.527,
   "e": 66.856,
   "text": "1878, mit 58 Jahren, erschien\nendlich sein erster Roman."
  },
  {
   "s": 66.856,
   "e": 69.753,
   "text": "Dann folgte einer\nnach dem anderen."
  },
  {
   "s": 69.753,
   "e": 72.141,
   "text": "Mit über 70 schrieb\ner „Effi Briest“."
  },
  {
   "s": 72.141,
   "e": 76.156,
   "text": "Ein Mädchen wird mit 17 an einen\nviel älteren Baron verheiratet."
  },
  {
   "s": 76.156,
   "e": 78.25,
   "text": "Sie langweilt sich,\nhat eine Affäre –"
  },
  {
   "s": 78.25,
   "e": 80.62,
   "text": "und Jahre später findet\nihr Mann die Briefe."
  },
  {
   "s": 80.62,
   "e": 83.451,
   "text": "Er tötet den Liebhaber im\nDuell und verstößt Effi."
  },
  {
   "s": 83.451,
   "e": 85.547,
   "text": "Die Geschichte hatte\nein wahres Vorbild:"
  },
  {
   "s": 85.547,
   "e": 88.882,
   "text": "Elisabeth von Ardenne.\nSie wurde 98 Jahre alt."
  },
  {
   "s": 88.882,
   "e": 92.307,
   "text": "Effis Vater sagt im Buch einen\nSatz, den wir bis heute benutzen:"
  },
  {
   "s": 92.307,
   "e": 94.748,
   "text": "„Das ist ein weites Feld.“"
  },
  {
   "s": 94.748,
   "e": 98.509,
   "text": "Theodor Fontane\nstarb 1898 in Berlin."
  },
  {
   "s": 98.509,
   "e": 99.956,
   "text": "Und Herr von Ribbeck?"
  },
  {
   "s": 99.956,
   "e": 101.582,
   "text": "Den gab es wirklich."
  },
  {
   "s": 101.582,
   "e": 103.799,
   "text": "Und auch den Birnbaum\nauf seinem Grab."
  },
  {
   "s": 103.799,
   "e": 106.239,
   "text": "1911 warf ihn ein Sturm um."
  },
  {
   "s": 106.239,
   "e": 109.071,
   "text": "Heute steht in Ribbeck\nwieder ein junger Birnbaum."
  },
  {
   "s": 109.071,
   "e": 111.083,
   "text": "„So spendet Segen\nnoch immer die Hand"
  },
  {
   "s": 111.083,
   "e": 113.592,
   "text": "des von Ribbeck auf\nRibbeck im Havelland.“"
  }
 ],
