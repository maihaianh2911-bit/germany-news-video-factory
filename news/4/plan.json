 "subs": [
  {
   "s": 0.3,
   "e": 2.245,
   "text": "Wir alle kennen\nihre Geschichten:"
  },
  {
   "s": 2.245,
   "e": 5.735,
   "text": "Hänsel und Gretel,\nRotkäppchen, Schneewittchen."
  },
  {
   "s": 5.735,
   "e": 10.435,
   "text": "Doch Jacob und Wilhelm Grimm wollten\ngar keine Kinderbücher schreiben."
  },
  {
   "s": 10.435,
   "e": 13.582,
   "text": "Sie wollten retten, was\ndie Leute sich erzählten,"
  },
  {
   "s": 13.582,
   "e": 15.418,
   "text": "bevor es verloren ging."
  },
  {
   "s": 15.418,
   "e": 18.412,
   "text": "Und ihr größtes Werk war\ngar nicht das Märchenbuch,"
  },
  {
   "s": 18.412,
   "e": 20.412,
   "text": "sondern ein Wörterbuch."
  },
  {
   "s": 20.412,
   "e": 27.165,
   "text": "Fertig wurde es erst 1961 –\nfast 100 Jahre nach ihrem Tod."
  },
  {
   "s": 27.165,
   "e": 33.419,
   "text": "Jacob wurde 1785 geboren, Wilhelm\nein Jahr später, beide in Hanau."
  },
  {
   "s": 33.419,
   "e": 36.404,
   "text": "Der Vater war Amtmann\nim hessischen Steinau."
  },
  {
   "s": 36.404,
   "e": 38.561,
   "text": "Als er starb, war Jacob elf."
  },
  {
   "s": 38.561,
   "e": 40.554,
   "text": "Die Familie geriet in Not."
  },
  {
   "s": 40.554,
   "e": 43.891,
   "text": "Die Brüder hielten zusammen –\nein ganzes Leben lang."
  },
  {
   "s": 43.891,
   "e": 46.619,
   "text": "Sie lernten zusammen,\narbeiteten zusammen"
  },
  {
   "s": 46.619,
   "e": 50.262,
   "text": "und lebten fast immer\nunter einem Dach."
  },
  {
   "s": 50.262,
   "e": 52.677,
   "text": "In Marburg studierten\nbeide Jura."
  },
  {
   "s": 52.677,
   "e": 55.255,
   "text": "Ihr Professor Friedrich\nCarl von Savigny"
  },
  {
   "s": 55.255,
   "e": 57.78,
   "text": "zeigte ihnen alte Handschriften."
  },
  {
   "s": 57.78,
   "e": 62.679,
   "text": "Ab 1806 schrieben sie auf,\nwas man sich in Hessen erzählte."
  },
  {
   "s": 62.679,
   "e": 66.012,
   "text": "Viele Märchen kamen von\njungen Frauen aus Kassel."
  },
  {
   "s": 66.012,
   "e": 70.515,
   "text": "Einige erzählte ihnen Dortchen Wild,\ndie Wilhelm später heiratete."
  },
  {
   "s": 70.515,
   "e": 75.739,
   "text": "Und rund 40 die Frau eines\nSchneiders: Dorothea Viehmann."
  },
  {
   "s": 75.739,
   "e": 81.324,
   "text": "Zu Weihnachten 1812 erschien\nder erste Band: 86 Märchen."
  },
  {
   "s": 81.324,
   "e": 83.369,
   "text": "Ein Kinderbuch war das nicht."
  },
  {
   "s": 83.369,
   "e": 87.198,
   "text": "Es hatte Anmerkungen für\nGelehrte – und viel Grausamkeit."
  },
  {
   "s": 87.198,
   "e": 90.127,
   "text": "Bei Schneewittchen war es\nnoch die eigene Mutter,"
  },
  {
   "s": 90.127,
   "e": 92.131,
   "text": "die das Kind töten wollte."
  },
  {
   "s": 92.131,
   "e": 95.132,
   "text": "Wilhelm überarbeitete\ndie Märchen immer wieder,"
  },
  {
   "s": 95.132,
   "e": 98.3,
   "text": "machte sie sanfter,\nfrommer, kindgerechter."
  },
  {
   "s": 98.3,
   "e": 101.17,
   "text": "Aus der Mutter wurde\ndie böse Stiefmutter."
  },
  {
   "s": 101.17,
   "e": 107.751,
   "text": "Die letzte Ausgabe,\n1857, hatte 200 Märchen."
  },
  {
   "s": 107.751,
   "e": 110.841,
   "text": "1837 kam der Bruch."
  },
  {
   "s": 110.841,
   "e": 114.159,
   "text": "Der König von Hannover\nhob die Verfassung auf."
  },
  {
   "s": 114.159,
   "e": 117.287,
   "text": "Sieben Professoren in\nGöttingen protestierten,"
  },
  {
   "s": 117.287,
   "e": 119.729,
   "text": "darunter Jacob\nund Wilhelm Grimm."
  },
  {
   "s": 119.729,
   "e": 121.959,
   "text": "Alle sieben wurden entlassen."
  },
  {
   "s": 121.959,
   "e": 125.179,
   "text": "Jacob musste das Land\nbinnen drei Tagen verlassen."
  },
  {
   "s": 125.179,
   "e": 129.489,
   "text": "Ganz Deutschland feierte\ndie „Göttinger Sieben“."
  },
  {
   "s": 129.489,
   "e": 134.354,
   "text": "1838 begannen sie das Werk,\ndas sie überleben sollte:"
  },
  {
   "s": 134.354,
   "e": 136.438,
   "text": "das Deutsche Wörterbuch."
  },
  {
   "s": 136.438,
   "e": 139.525,
   "text": "Es sollte die Geschichte der\ndeutschen Wörter erzählen,"
  },
  {
   "s": 139.525,
   "e": 141.368,
   "text": "von Luther bis Goethe."
  },
  {
   "s": 141.368,
   "e": 146.381,
   "text": "Wilhelm starb 1859 –\ner war beim Buchstaben D."
  },
  {
   "s": 146.381,
   "e": 151.346,
   "text": "Jacob arbeitete weiter,\nbis zu seinem Tod 1863."
  },
  {
   "s": 151.346,
   "e": 154.6,
   "text": "Sein letztes Wort im\nWörterbuch war „Frucht“."
  },
  {
   "s": 154.6,
   "e": 157.875,
   "text": "Andere führten es fort,\nüber ein Jahrhundert lang."
  },
  {
   "s": 157.875,
   "e": 162.059,
   "text": "Ihre Märchen gehören heute zum\nWeltdokumentenerbe der UNESCO."
  },
  {
   "s": 162.059,
   "e": 165.006,
   "text": "Und fast jedes beginnt\nmit denselben Worten:"
  },
  {
   "s": 165.006,
   "e": 166.511,
   "text": "„Es war einmal …“"
  }
 ],
