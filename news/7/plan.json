 "subs": [
  {
   "s": 0.3,
   "e": 1.839,
   "text": "„Dort, wo man Bücher verbrennt,"
  },
  {
   "s": 1.839,
   "e": 4.042,
   "text": "verbrennt man auch\nam Ende Menschen.“"
  },
  {
   "s": 4.042,
   "e": 7.724,
   "text": "Diesen Satz schrieb\nHeinrich Heine 1821."
  },
  {
   "s": 7.724,
   "e": 12.444,
   "text": "Über hundert Jahre später, 1933,\nbrannten auch seine Bücher."
  },
  {
   "s": 12.444,
   "e": 15.368,
   "text": "Und doch singen wir bis heute\nsein Lied von der Loreley."
  },
  {
   "s": 15.368,
   "e": 17.343,
   "text": "Ein Dichter, der\nDeutschland liebte –"
  },
  {
   "s": 17.343,
   "e": 22.206,
   "text": "und die letzten 25 Jahre seines\nLebens in Paris verbrachte."
  },
  {
   "s": 22.206,
   "e": 26.727,
   "text": "Geboren wurde er 1797 in\nDüsseldorf, als Harry Heine."
  },
  {
   "s": 26.727,
   "e": 28.393,
   "text": "Die Familie war jüdisch."
  },
  {
   "s": 28.393,
   "e": 31.127,
   "text": "Sein reicher Onkel Salomon,\nBankier in Hamburg,"
  },
  {
   "s": 31.127,
   "e": 33.205,
   "text": "wollte einen Kaufmann\naus ihm machen."
  },
  {
   "s": 33.205,
   "e": 35.108,
   "text": "Harry gründete\nein Tuchgeschäft –"
  },
  {
   "s": 35.108,
   "e": 36.832,
   "text": "nach einem Jahr war es pleite."
  },
  {
   "s": 36.832,
   "e": 40.784,
   "text": "Der Onkel bezahlte ihm\nstattdessen ein Jurastudium."
  },
  {
   "s": 40.784,
   "e": 44.837,
   "text": "1825 ließ er sich taufen\nund hieß nun Heinrich."
  },
  {
   "s": 44.837,
   "e": 46.353,
   "text": "Den Taufzettel nannte er „das"
  },
  {
   "s": 46.353,
   "e": 48.75,
   "text": "Entréebillett zur\neuropäischen Kultur“."
  },
  {
   "s": 48.75,
   "e": 52.235,
   "text": "Eine Stelle als Jurist\nbekam er trotzdem nie."
  },
  {
   "s": 52.235,
   "e": 55.917,
   "text": "1827 erschien sein\n„Buch der Lieder“."
  },
  {
   "s": 55.917,
   "e": 59.387,
   "text": "Darin stand ein Gedicht über eine\nFrau auf einem Felsen am Rhein:"
  },
  {
   "s": 59.387,
   "e": 61.455,
   "text": "„Ich weiß nicht,\nwas soll es bedeuten,"
  },
  {
   "s": 61.455,
   "e": 63.037,
   "text": "dass ich so traurig bin.“"
  },
  {
   "s": 63.037,
   "e": 67.229,
   "text": "Friedrich Silcher machte daraus\nein Lied, das bald jeder sang."
  },
  {
   "s": 67.229,
   "e": 70.073,
   "text": "Heine spottete über Fürsten,\nZensur und Spießer."
  },
  {
   "s": 70.073,
   "e": 72.84,
   "text": "1831 zog er nach Paris."
  },
  {
   "s": 72.84,
   "e": 76.51,
   "text": "Vier Jahre später wurden seine\nSchriften in Deutschland verboten."
  },
  {
   "s": 76.51,
   "e": 79.731,
   "text": "In Paris heiratete er Mathilde,\neine junge Verkäuferin."
  },
  {
   "s": 79.731,
   "e": 83.566,
   "text": "Seine Gedichte las sie nie –\nsie konnte kein Deutsch."
  },
  {
   "s": 83.566,
   "e": 87.504,
   "text": "1843 fuhr er noch einmal nach\nHamburg, zu seiner Mutter."
  },
  {
   "s": 87.504,
   "e": 90.269,
   "text": "Daraus wurde „Deutschland.\nEin Wintermärchen“."
  },
  {
   "s": 90.269,
   "e": 93.233,
   "text": "Und aus der Sehnsucht nach ihr\nein Gedicht, das wir alle kennen:"
  },
  {
   "s": 93.233,
   "e": 94.886,
   "text": "„Denk ich an Deutschland\nin der Nacht,"
  },
  {
   "s": 94.886,
   "e": 97.933,
   "text": "dann bin ich um den\nSchlaf gebracht.“"
  },
  {
   "s": 97.933,
   "e": 102.325,
   "text": "Im Mai 1848 schleppte er sich\nein letztes Mal in den Louvre,"
  },
  {
   "s": 102.325,
   "e": 103.896,
   "text": "zur Venus von Milo."
  },
  {
   "s": 103.896,
   "e": 106.118,
   "text": "Danach verließ er\nsein Bett kaum noch."
  },
  {
   "s": 106.118,
   "e": 109.253,
   "text": "Acht Jahre lag er gelähmt\nin seiner „Matratzengruft“"
  },
  {
   "s": 109.253,
   "e": 112.201,
   "text": "und schrieb weiter: Gedichte,\nSpott, Erinnerungen."
  },
  {
   "s": 112.201,
   "e": 115.862,
   "text": "Heinrich Heine\nstarb 1856 in Paris."
  },
  {
   "s": 115.862,
   "e": 118.926,
   "text": "Er liegt auf dem\nFriedhof Montmartre."
  },
  {
   "s": 118.926,
   "e": 123.051,
   "text": "1933 warfen Studenten auch\nseine Bücher ins Feuer."
  },
  {
   "s": 123.051,
   "e": 125.688,
   "text": "Heute steht sein Satz in\nBerlin auf dem Bebelplatz –"
  },
  {
   "s": 125.688,
   "e": 127.763,
   "text": "genau dort, wo die\nBücher brannten."
  },
  {
   "s": 127.763,
   "e": 131.575,
   "text": "Und am Rhein fahren die Schiffe\nnoch immer am Loreley-Felsen vorbei."
  }
 ],
