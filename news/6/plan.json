 "subs": [
  {
   "s": 0.3,
   "e": 3.766,
   "text": "Friedrich Schiller schrieb\ndie „Ode an die Freude“."
  },
  {
   "s": 3.766,
   "e": 8.676,
   "text": "Beethoven machte sie unsterblich,\nEuropa ihre Melodie zu seiner Hymne."
  },
  {
   "s": 8.676,
   "e": 12.311,
   "text": "Doch Schillers eigenes Leben\nwar selten voller Freude."
  },
  {
   "s": 12.311,
   "e": 16.58,
   "text": "Er floh vor einem Herzog, lebte\nin Armut, war fast immer krank."
  },
  {
   "s": 16.58,
   "e": 19.304,
   "text": "Mit 45 Jahren war er tot."
  },
  {
   "s": 19.304,
   "e": 20.822,
   "text": "Und sein Schädel?"
  },
  {
   "s": 20.822,
   "e": 24.324,
   "text": "Lag über 180 Jahre in\neiner Fürstengruft –"
  },
  {
   "s": 24.324,
   "e": 29.081,
   "text": "bis ein Gentest zeigte:\nEr war gar nicht von Schiller."
  },
  {
   "s": 29.081,
   "e": 34.989,
   "text": "Geboren wurde er am 10. November\n1759 in Marbach am Neckar."
  },
  {
   "s": 34.989,
   "e": 36.878,
   "text": "Er wollte Pfarrer werden."
  },
  {
   "s": 36.878,
   "e": 39.117,
   "text": "Doch der Herzog von Württemberg"
  },
  {
   "s": 39.117,
   "e": 42.598,
   "text": "holte den 13-Jährigen\nin seine Militärschule."
  },
  {
   "s": 42.598,
   "e": 46.288,
   "text": "Uniform, Drill und strenge\nRegeln – sieben Jahre lang."
  },
  {
   "s": 46.288,
   "e": 50.785,
   "text": "Heimlich schrieb er ein\nTheaterstück: Die Räuber."
  },
  {
   "s": 50.785,
   "e": 55.177,
   "text": "1782 wurde es in\nMannheim uraufgeführt."
  },
  {
   "s": 55.177,
   "e": 59.258,
   "text": "Ein Zuschauer schrieb: „Das\nTheater glich einem Irrenhause.“"
  },
  {
   "s": 59.258,
   "e": 62.361,
   "text": "Schiller war ohne\nErlaubnis hingefahren."
  },
  {
   "s": 62.361,
   "e": 65.231,
   "text": "Der Herzog ließ ihn\n14 Tage einsperren"
  },
  {
   "s": 65.231,
   "e": 69.788,
   "text": "und verbot ihm, etwas anderes als\nmedizinische Schriften zu verfassen."
  },
  {
   "s": 69.788,
   "e": 74.895,
   "text": "Im September 1782 floh\nSchiller nachts aus Stuttgart,"
  },
  {
   "s": 74.895,
   "e": 78.916,
   "text": "während der Hof ein\ngroßes Fest feierte."
  },
  {
   "s": 78.916,
   "e": 82.953,
   "text": "Verschuldet und arm, fand er\nin Leipzig und Dresden Freunde."
  },
  {
   "s": 82.953,
   "e": 86.272,
   "text": "Dort schrieb er 1785\nein Gedicht über"
  },
  {
   "s": 86.272,
   "e": 89.404,
   "text": "die Freude und die Freundschaft:"
  },
  {
   "s": 89.404,
   "e": 91.703,
   "text": "„Freude, schöner Götterfunken“."
  },
  {
   "s": 91.703,
   "e": 96.323,
   "text": "Fast 40 Jahre später\nvertonte es Beethoven."
  },
  {
   "s": 96.323,
   "e": 101.106,
   "text": "1789 wurde Schiller Professor\nfür Geschichte in Jena."
  },
  {
   "s": 101.106,
   "e": 104.466,
   "text": "Zu seiner ersten Vorlesung\nkamen so viele Studenten,"
  },
  {
   "s": 104.466,
   "e": 108.511,
   "text": "dass alle in den größten Hörsaal\nder Stadt umziehen mussten."
  },
  {
   "s": 108.511,
   "e": 111.137,
   "text": "Er heiratete Charlotte\nvon Lengefeld."
  },
  {
   "s": 111.137,
   "e": 115.202,
   "text": "Doch 1791 erkrankte er\nschwer an der Lunge."
  },
  {
   "s": 115.202,
   "e": 118.326,
   "text": "Gesund wurde er nie wieder."
  },
  {
   "s": 118.326,
   "e": 122.317,
   "text": "1794 begann die\nFreundschaft mit Goethe,"
  },
  {
   "s": 122.317,
   "e": 125.827,
   "text": "eine Freundschaft, die die\ndeutsche Literatur prägte."
  },
  {
   "s": 125.827,
   "e": 129.588,
   "text": "In seinen letzten Jahren\nschrieb Schiller Stück um Stück:"
  },
  {
   "s": 129.588,
   "e": 134.215,
   "text": "Wallenstein, Maria Stuart, Die\nJungfrau von Orleans, Wilhelm Tell."
  },
  {
   "s": 134.215,
   "e": 136.133,
   "text": "Und „Das Lied von der Glocke“,"
  },
  {
   "s": 136.133,
   "e": 140.764,
   "text": "das viele von uns in der Schule\nauswendig lernen mussten."
  },
  {
   "s": 140.764,
   "e": 146.992,
   "text": "Am 9. Mai 1805 starb Friedrich\nSchiller in Weimar, mit 45 Jahren."
  },
  {
   "s": 146.992,
   "e": 150.606,
   "text": "Er wurde nachts in einer\nGemeinschaftsgruft beigesetzt."
  },
  {
   "s": 150.606,
   "e": 154.699,
   "text": "21 Jahre später suchte man\ndort nach seinem Schädel"
  },
  {
   "s": 154.699,
   "e": 156.929,
   "text": "und brachte ihn in\ndie Fürstengruft,"
  },
  {
   "s": 156.929,
   "e": 159.68,
   "text": "wo später auch Goethe\nbeigesetzt wurde."
  },
  {
   "s": 159.68,
   "e": 164.835,
   "text": "2008 zeigte ein Gentest: Der\nSchädel stammte nicht von Schiller."
  },
  {
   "s": 164.835,
   "e": 167.901,
   "text": "Sein Sarg in der Fürstengruft\nist seitdem leer."
  },
  {
   "s": 167.901,
   "e": 171.234,
   "text": "Doch seine Ode erklingt\nbis heute in ganz Europa:"
  },
  {
   "s": 171.234,
   "e": 173.309,
   "text": "„Alle Menschen werden Brüder.“"
  }
 ],
