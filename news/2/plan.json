 "subs": [
  {
   "s": 1.0,
   "e": 4.02,
   "text": "Das Gericht legte\nganze 44 Beweise vor,",
   "hl": [
    "44 Beweise"
   ]
  },
  {
   "s": 4.27,
   "e": 7.657,
   "text": "doch Gina H. beteuert weiter\nentschlossen ihre Unschuld –",
   "hl": [
    "Unschuld"
   ]
  },
  {
   "s": 7.907,
   "e": 10.166,
   "text": "im Mordfall des\nachtjährigen Fabian!",
   "hl": []
  },
  {
   "s": 10.616,
   "e": 14.024,
   "text": "Im Oktober 2025\nverschwand Fabian.",
   "hl": [
    "Oktober 2025"
   ]
  },
  {
   "s": 14.474,
   "e": 16.631,
   "text": "Vier Tage später\nwurde der Junge tot",
   "hl": [
    "Teich"
   ]
  },
  {
   "s": 16.751,
   "e": 18.782,
   "text": "an einem kleinen\nTeich gefunden,",
   "hl": [
    "Teich"
   ]
  },
  {
   "s": 19.032,
   "e": 21.791,
   "text": "15 Kilometer von seinem\nZuhause entfernt.",
   "hl": []
  },
  {
   "s": 22.241,
   "e": 24.578,
   "text": "Und ausgerechnet Gina\nmeldete den Fund –",
   "hl": [
    "Gina"
   ]
  },
  {
   "s": 24.698,
   "e": 26.555,
   "text": "die Ex-Freundin\nseines Vaters.",
   "hl": [
    "Gina"
   ]
  },
  {
   "s": 27.005,
   "e": 28.204,
   "text": "Der Polizei sagte sie,",
   "hl": [
    "„zufällig“"
   ]
  },
  {
   "s": 28.324,
   "e": 30.383,
   "text": "sie sei nur „zufällig“\nvorbeigekommen",
   "hl": [
    "„zufällig“"
   ]
  },
  {
   "s": 30.503,
   "e": 32.224,
   "text": "und habe die\nLeiche entdeckt.",
   "hl": [
    "„zufällig“"
   ]
  },
  {
   "s": 32.674,
   "e": 34.753,
   "text": "Doch vor Gericht\nflog diese Lüge auf!",
   "hl": [
    "Lüge"
   ]
  },
  {
   "s": 35.203,
   "e": 37.971,
   "text": "Ein Zeuge, der damals\ndabei war, versicherte,",
   "hl": []
  },
  {
   "s": 38.221,
   "e": 41.49,
   "text": "Gina sei ohne Umweg direkt\nmit ihm zum Teich gegangen,",
   "hl": [
    "direkt"
   ]
  },
  {
   "s": 41.74,
   "e": 44.975,
   "text": "als hätte sie schon vorher\ngenau gewusst, wo er liegt.",
   "hl": []
  },
  {
   "s": 45.425,
   "e": 47.941,
   "text": "Zwar gibt es keinen\nAugenzeugen der Tat,",
   "hl": []
  },
  {
   "s": 48.191,
   "e": 50.571,
   "text": "doch 44 Indizien\nbilden eine Kette,",
   "hl": [
    "44 Indizien"
   ]
  },
  {
   "s": 50.691,
   "e": 52.774,
   "text": "die sich nicht\nleugnen lässt:",
   "hl": [
    "44 Indizien"
   ]
  },
  {
   "s": 53.024,
   "e": 55.325,
   "text": "von Schuhabdrücken\nüber Faserspuren",
   "hl": [
    "Schuhabdrücken",
    "Faserspuren"
   ]
  },
  {
   "s": 55.575,
   "e": 57.07,
   "text": "bis hin zu Ginas Handy,",
   "hl": [
    "Handy"
   ]
  },
  {
   "s": 57.32,
   "e": 59.601,
   "text": "das genau zu der Zeit\nausgeschaltet war,",
   "hl": []
  },
  {
   "s": 59.721,
   "e": 61.42,
   "text": "als der Junge getötet wurde.",
   "hl": []
  },
  {
   "s": 61.87,
   "e": 65.147,
   "text": "Im November 2026\nverurteilte das Gericht",
   "hl": [
    "lebenslanger Haft"
   ]
  },
  {
   "s": 65.267,
   "e": 68.499,
   "text": "Gina wegen Mordes\nzu lebenslanger Haft",
   "hl": [
    "lebenslanger Haft"
   ]
  },
  {
   "s": 68.749,
   "e": 71.668,
   "text": "und stellte die besondere\nSchwere der Schuld fest.",
   "hl": [
    "besondere Schwere"
   ]
  },
  {
   "s": 72.118,
   "e": 74.702,
   "text": "Doch abgeschlossen ist\nder Fall noch nicht:",
   "hl": []
  },
  {
   "s": 74.952,
   "e": 77.287,
   "text": "Ihre Verteidigung\nhat soeben Revision",
   "hl": [
    "Revision"
   ]
  },
  {
   "s": 77.407,
   "e": 79.603,
   "text": "beim Bundesgerichtshof\neingelegt.",
   "hl": [
    "Revision"
   ]
  },
  {
   "s": 80.053,
   "e": 82.585,
   "text": "Was meint ihr: Wird\ndieses Urteil gekippt?",
   "hl": [
    "gekippt"
   ]
  }
 ],
